---
import Layout from '../layouts/Layout.astro';
import ProfileSection from '../components/Profile.astro';
import PublicationCard from "../components/PublicationCard.astro";
import PublicationImageModal from "../components/PublicationImageModal.astro";
import Timeline from "../components/Timeline.astro";
import { getCollection } from "astro:content";
import { ArrowRight, LibraryBig } from "lucide-astro";

const introductionEntries = await getCollection("introduction");
const introduction = introductionEntries[0];

const recentPublications = (await getCollection("publications"))
  .filter((publication) => publication.data.featured)
  .sort(
    (a, b) =>
      b.data.year - a.data.year ||
      a.data.title.localeCompare(b.data.title),
  )
  .slice(0, 3);

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: "https://afrindange.github.io/",
  name: "Afrin Dange",
  mainEntity: {
    "@type": "Person",
    "@id": "https://afrindange.github.io/#afrin-dange",
    name: "Afrin Dange",
    url: "https://afrindange.github.io/",
    image: "https://afrindange.github.io/images/profile.png",
    jobTitle: "Research Scientist",
    worksFor: {
      "@type": "Organization",
      name: "Amazon Lab126",
    },
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "Indian Institute of Technology Bombay",
    },
    knowsAbout: introduction?.data.researchAreas ?? [],
    sameAs: introduction?.data.socials.map((social) => social.url) ?? [],
  },
};
---

<Layout structuredData={profileSchema}>
  <ProfileSection />

  <section id="publications" class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <div class="flex items-center justify-between gap-4 mb-7">
      <div>
        <h2 class="flex items-center gap-2 text-2xl font-semibold">
          <LibraryBig class="w-5 h-5 text-theme-accent shrink-0" />
          Publications
        </h2>
      </div>

      <a href="/publications" class="inline-flex items-center gap-1 text-sm shrink-0">
        View all
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>

    <div>
      {recentPublications.map((publication) => (
        <PublicationCard publication={publication} headingLevel="h3" />
      ))}
    </div>
  </section>

  <Timeline />
  <PublicationImageModal />
</Layout>
