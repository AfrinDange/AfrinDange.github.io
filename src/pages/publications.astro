---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PublicationCard from '../components/PublicationCard.astro';
import PublicationImageModal from '../components/PublicationImageModal.astro';
import { LibraryBig } from 'lucide-astro';

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title),
);
---

<Layout>
  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <div class="mb-8 max-w-3xl">
      <h1 class="flex items-center gap-3 text-3xl font-bold">
        <LibraryBig class="h-6 w-6 shrink-0 text-theme-accent" />
        <span>Publications</span>
      </h1>
    </div>

    <div>
      {publications.map((publication) => (
        <PublicationCard publication={publication} />
      ))}
    </div>
  </section>

  <PublicationImageModal />
</Layout>
