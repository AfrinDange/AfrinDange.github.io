---
import type { CollectionEntry } from "astro:content";
import { Braces, FileText, Github } from "lucide-astro";

interface Props {
  publication: CollectionEntry<"publications">;
  headingLevel?: "h2" | "h3";
}

const { publication, headingLevel = "h2" } = Astro.props;
const { title, authors, venue, year, highlight, image, imageAlt, links } = publication.data;
const titleClasses = "text-lg font-semibold leading-snug sm:text-xl";
---

<article class="grid gap-4 border-b border-theme-textDark/10 py-6 last:border-b-0 dark:border-theme-textLight/10 sm:grid-cols-[8.5rem_1fr] sm:gap-6">
  <button
    type="button"
    class="h-28 w-full cursor-pointer overflow-hidden rounded-md border border-theme-textDark/10 bg-white dark:border-theme-textLight/10 sm:w-[8.5rem]"
    data-publication-image={image}
    data-publication-alt={imageAlt}
    aria-label={`Enlarge image for ${title}`}
  >
    <img src={image} alt={imageAlt} class="h-full w-full object-cover" loading="lazy" />
  </button>

  <div>
    {headingLevel === "h2" ? (
      <h2 class={titleClasses}>{title}</h2>
    ) : (
      <h3 class={titleClasses}>{title}</h3>
    )}

    <p class="mt-2 text-sm leading-6 text-theme-textDark/65 dark:text-theme-textLight/65">
      {authors.map((author, index) => (
        <>
          {index > 0 && ", "}
          {author.me ? <strong class="text-theme-textDark dark:text-theme-textLight">{author.name}</strong> : author.name}
        </>
      ))}
    </p>

    <p class="mt-1 text-sm">
      {venue} <span class="text-theme-textDark/40 dark:text-theme-textLight/40">· {year}</span>
      {highlight && (
        <span class="ml-2 rounded-full bg-theme-accent/10 px-2 py-0.5 text-xs font-semibold text-theme-accent">
          {highlight}
        </span>
      )}
    </p>

    <div class="mt-3 flex flex-wrap gap-4 text-sm">
      {links.code ? (
        <a href={links.code} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-theme-accent hover:underline">
          <Github class="h-4 w-4" /> Code
        </a>
      ) : (
        <span class="inline-flex cursor-not-allowed items-center gap-1.5 text-theme-textDark/25 dark:text-theme-textLight/25" aria-disabled="true" title="Code is not available">
          <Github class="h-4 w-4" /> Code
        </span>
      )}
      {links.paper ? (
        <a href={links.paper} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-theme-accent hover:underline">
          <FileText class="h-4 w-4" /> Manuscript
        </a>
      ) : (
        <span class="inline-flex cursor-not-allowed items-center gap-1.5 text-theme-textDark/25 dark:text-theme-textLight/25" aria-disabled="true" title="Manuscript is not available">
          <FileText class="h-4 w-4" /> Manuscript
        </span>
      )}
      {links.bibtex ? (
        <button
          type="button"
          data-bibtex-url={links.bibtex}
          class="inline-flex items-center gap-1.5 text-theme-accent hover:underline"
          title="Copy BibTeX"
        >
          <Braces class="h-4 w-4" />
          <span data-bibtex-label>BibTeX</span>
        </button>
      ) : (
        <span class="inline-flex cursor-not-allowed items-center gap-1.5 text-theme-textDark/25 dark:text-theme-textLight/25" aria-disabled="true" title="BibTeX is not available">
          <Braces class="h-4 w-4" /> BibTeX
        </span>
      )}
    </div>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-bibtex-url]").forEach((button) => {
    if (button.dataset.copyReady === "true") return;
    button.dataset.copyReady = "true";

    button.addEventListener("click", async () => {
      const url = button.dataset.bibtexUrl;
      const label = button.querySelector<HTMLElement>("[data-bibtex-label]");
      if (!url || !label) return;

      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error("Could not load BibTeX");

        await navigator.clipboard.writeText(await response.text());
        label.textContent = "Copied";
      } catch {
        label.textContent = "Copy failed";
      }

      window.setTimeout(() => {
        label.textContent = "BibTeX";
      }, 1600);
    });
  });
</script>
