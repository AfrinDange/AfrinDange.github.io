<div
  id="publication-image-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Publication image"
>
  <button
    type="button"
    class="absolute inset-0 cursor-default"
    data-close-publication-modal
    aria-label="Close image"
  ></button>
  <img
    id="publication-modal-image"
    src=""
    alt=""
    class="relative max-h-[90vh] max-w-[90vw] rounded shadow-lg"
  />
</div>

<script>
  const modal = document.getElementById("publication-image-modal");
  const modalImage = document.getElementById(
    "publication-modal-image",
  ) as HTMLImageElement | null;
  const closeButton = modal?.querySelector(
    "[data-close-publication-modal]",
  ) as HTMLButtonElement | null;

  const closeModal = () => {
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
  };

  document.querySelectorAll("[data-publication-image]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!modal || !modalImage) return;

      modalImage.src = button.getAttribute("data-publication-image") ?? "";
      modalImage.alt = button.getAttribute("data-publication-alt") ?? "";
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      closeButton?.focus();
    });
  });

  closeButton?.addEventListener("click", closeModal);

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeModal();
  });
</script>
