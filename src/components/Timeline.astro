---
import { getCollection } from "astro:content";
import { iconMap } from "../data/iconmap.js";
import { Milestone } from "lucide-astro";

const updates = (await getCollection("updates")).sort(
  (a, b) => b.data.date.localeCompare(a.data.date),
);

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T00:00:00Z`));
---

<section id="updates" class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
  <div class="mb-5">
    <h2 class="flex items-center gap-2 text-2xl font-semibold">
      <Milestone class="h-5 w-5 text-theme-accent" />
      Updates
    </h2>
  </div>

  <div
    data-updates-list
    class="relative h-[24rem] space-y-4 overflow-y-auto border-l-2 border-theme-accent/20 pl-4 pr-2 dark:border-theme-accent/30"
  >
    {updates.map((update) => {
      const Icon = iconMap[update.data.icon];
      return (
        <article data-update-card class="relative ml-4 rounded-md border border-theme-textDark/10 bg-theme-bgLight px-3 py-2 shadow-sm shadow-black/5 transition hover:shadow-md dark:border-theme-textLight/10 dark:bg-theme-bgDark/60 dark:shadow-white/5">
          <time class="mb-1 block font-mono text-xs text-theme-textDark/60 dark:text-theme-textLight/60" datetime={update.data.date}>
            {formatDate(update.data.date)}
          </time>
          <p class="flex items-start gap-2 text-base leading-6 text-theme-textDark dark:text-theme-textLight">
            {Icon && <Icon class="mt-1 h-4 w-4 shrink-0 text-theme-accent" />}
            <span>{update.data.text}</span>
          </p>
        </article>
      );
    })}
  </div>
</section>

<script>
  const updatesList = document.querySelector<HTMLElement>("[data-updates-list]");
  const updateCards = updatesList?.querySelectorAll<HTMLElement>("[data-update-card]");

  const fitFourUpdates = () => {
    if (!updatesList || !updateCards || updateCards.length < 4) return;

    const fourthCard = updateCards[3];
    updatesList.style.height = `${fourthCard.offsetTop + fourthCard.offsetHeight}px`;
  };

  fitFourUpdates();
  window.addEventListener("resize", fitFourUpdates);

  if (updateCards) {
    const resizeObserver = new ResizeObserver(fitFourUpdates);
    Array.from(updateCards).slice(0, 4).forEach((card) => resizeObserver.observe(card));
  }
</script>
