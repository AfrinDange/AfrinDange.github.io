---
import { updates } from "../data/updates.js";
import { iconMap } from "../data/iconMap.js";
import { Milestone } from "lucide-astro";
---

<section class="max-w-5xl mx-auto mt-8 px-4">
  <h2 class="text-2xl font-heading font-semibold mb-6 flex items-center gap-2 text-theme-textDark dark:text-theme-textLight">
    <Milestone class="w-5 h-5 text-theme-accent shrink-0" />
    Updates
  </h2>

  <div class="relative pl-4 border-l-2 border-theme-accent/20 dark:border-theme-accent/30 space-y-4 max-h-[18.5rem] overflow-y-auto pr-2">
    {updates.map(({ date, icon, text }, index) => {
      const Icon = iconMap[icon];
      return (
        <div class="pl-4 border-l-2 border-transparent relative">
          <div class="py-2 px-3 rounded-md bg-theme-bgLight dark:bg-theme-bgDark/60 shadow-sm shadow-black/5 dark:shadow-white/5 border border-theme-textDark/10 dark:border-theme-textLight/10 transition hover:shadow-md">
            <p class="text-xs font-mono text-theme-textDark/60 dark:text-theme-textLight/60 mb-1">{date}</p>
            <p class="text-base flex items-center gap-2 text-theme-textDark dark:text-theme-textLight">
              {Icon && <Icon class="w-4 h-4 text-theme-accent shrink-0" />}
              {text}
            </p>
          </div>
        </div>
      );
    })}
  </div>
</section>
