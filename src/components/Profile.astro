---
import { getCollection, render } from "astro:content";
import { FileText } from "lucide-astro";
import ProfileCat from "./ProfileCat.astro";

const entries = await getCollection("introduction");
const introduction = entries[0];

if (!introduction) {
  throw new Error("Add an introduction Markdown file in src/content/introduction.");
}

const { Content } = await render(introduction);
const iconClasses = {
  "google-scholar": "fas fa-graduation-cap",
  linkedin: "fab fa-linkedin",
  github: "fab fa-github",
  x: "fab fa-x-twitter",
};
---

<section id="research" class="mx-auto max-w-5xl px-4 pb-10 pt-8 sm:px-6 md:pb-14 md:pt-12">
  <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_12rem] md:items-start md:gap-8">
    <div>
      <h1 class="mb-5 text-4xl font-bold sm:text-5xl">
        {introduction.data.greeting}<ProfileCat />
      </h1>

      {introduction.data.note && (
        <aside class="profile-note">
          <p>{introduction.data.note}</p>
        </aside>
      )}

      <div class="introduction-content text-[0.97rem] text-theme-textDark/80 dark:text-theme-textLight/80">
        <Content />
      </div>

      {introduction.data.researchAreas && (
        <p class="mt-5 text-sm leading-6">
          <strong>Research interests:</strong>
          {introduction.data.researchAreas.join(", ")}
        </p>
      )}
    </div>

    <aside class="flex flex-col items-center gap-4 md:pt-2">
      <img
        src={introduction.data.photo}
        alt={introduction.data.photoAlt}
        class="h-56 w-48 rounded-xl object-cover shadow-sm"
      />

      <div class="flex items-center justify-center gap-4 text-xl">
        {introduction.data.socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="me noopener noreferrer"
            aria-label={social.label}
            title={social.label}
            class="hover:text-theme-accent"
          >
            <i class={iconClasses[social.icon]}></i>
          </a>
        ))}
        <a
          href="/assets/afrin_dange_cv.pdf"
          target="_blank"
          aria-label="Curriculum Vitae"
          title="Curriculum Vitae"
          class="hover:text-theme-accent"
        >
          <FileText class="h-5 w-5" />
        </a>
      </div>
    </aside>
  </div>
</section>

<style>
  .introduction-content :global(p) {
    margin-bottom: 0.7rem;
    line-height: 1.65;
    text-align: justify;
  }

  .introduction-content :global(a) {
    color: #7c3aed;
    text-decoration: underline;
    text-decoration-color: rgb(124 58 237 / 0.3);
    text-underline-offset: 3px;
  }

  .profile-note {
    margin-bottom: 1.15rem;
    border-left: 3px solid #7c3aed;
    border-radius: 0 0.5rem 0.5rem 0;
    background: rgb(124 58 237 / 0.07);
    padding: 0.65rem 0.9rem;
  }

  .profile-note p {
    margin: 0;
    color: #6d28d9;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
  }

  :global(.dark) .profile-note {
    background: rgb(167 139 250 / 0.1);
  }

  :global(.dark) .profile-note p {
    color: #c4b5fd;
  }
</style>
